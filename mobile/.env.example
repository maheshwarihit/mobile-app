EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# The Google OAuth "Web application" Client ID already configured in
# Supabase's Google provider (Authentication → Providers → Google) — reused
# here for native Google Sign-In, NOT a new/different Client ID. See
# src/lib/oauth.ts's doc comment.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
