{
  "expo": {
    "name": "VAgeWell Care",
    "slug": "vagewellcare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/logo.png"
    },
    "scheme": "vagewell",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "in.vagewell.care"
    },
    "android": {
      "package": "in.vagewell.care",
      "versionCode": 5,
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "VAgeWell needs access to your photos so you can upload a payment screenshot.",
          "cameraPermission": "VAgeWell needs camera access so Care Givers can take a visit photo with the patient."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "VAgeWell needs your location so a visit photo can be tagged with where the visit took place."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-asset",
      "expo-document-picker",
      "expo-web-browser",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "eas": {
        "projectId": "eeb02a21-5219-427d-9781-97b9edde3b47"
      }
    },
    "owner": "vagewellcare"
  }
}
